# Copy this file to .env and adjust if needed. Values below are safe local
# defaults, not secrets — fine to commit as an example.

POSTGRES_USER=croupier
POSTGRES_PASSWORD=croupier
POSTGRES_DB=croupier
POSTGRES_PORT=5432

LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
# Realm/clients are provisioned automatically from deploy/keycloak/realm-export.json.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/croupier

# cmd/croupier itself (Fase 10). Runs with network_mode: host in
# docker-compose.yml (see the comment there for why), so every URL above
# already works unchanged for the app container too — no separate
# in-network hostnames to configure.
APP_PORT=8081

# Everything below has a sensible built-in default (see cmd/croupier/config.go)
# and isn't read by docker-compose.yml — set these only if you're running
# `go run ./cmd/croupier` yourself and want to override one.
# AWS_REGION=us-east-1
# WAGER_TRANSACTIONS_QUEUE_NAME=wager-transactions.fifo
# WAGER_TRANSACTIONS_DLQ_NAME=wager-transactions-dlq.fifo
# WALLET_EVENTS_QUEUE_NAME=wallet-events.fifo
# SQS_CONSUMER_NAME=wager-transactions-consumer
# PENDING_REFERENCE_POLL_INTERVAL=5s
# PENDING_REFERENCE_MAX_ATTEMPTS=10
# PENDING_REFERENCE_TTL=24h
# PENDING_REFERENCE_BACKOFF_BASE=5s
# OUTBOX_POLL_INTERVAL=1s
# OUTBOX_BACKOFF_BASE=2s
# SHUTDOWN_TIMEOUT=15s
# DLQ_DEPTH_POLL_INTERVAL=30s
